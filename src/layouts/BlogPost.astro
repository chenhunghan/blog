---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { url } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { id: string; headings?: MarkdownHeading[] };

const { id, title, description, pubDate, updatedDate, heroImage, tags, headings = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={url(`og/${id}.png`)}
			article={{ published: pubDate, modified: updatedDate, tags }}
		/>
	</head>
	<body>
		<Header />
		<main class="container">
			<article>
				<header>
					<h1>{title}</h1>
					<p class="meta muted">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									{' · updated '}
									<FormattedDate date={updatedDate} />
								</>
							)
						}
					</p>
				</header>
				{heroImage && <Image class="hero" width={1344} src={heroImage} alt="" />}
				<div class="prose">
					<TableOfContents headings={headings} />
					<slot />
				</div>
			</article>
			<RelatedPosts currentId={id} tags={tags} />
		</main>
		<Footer />
		<script>
			// Videos marked data-autoplay play silently on a loop, unless the reader prefers reduced
			// motion: then they stay on their first frame with controls to play on demand.
			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
			for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')) {
				if (reduceMotion) video.controls = true;
				else video.play().catch(() => (video.controls = true));
			}
		</script>
	</body>
</html>
<style>
	article > header {
		margin: 1.5rem 0 2rem;
	}
	.meta {
		margin: 0;
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}
	.hero {
		width: 100%;
		margin-bottom: 2rem;
	}
	/* The table of contents sidebar is positioned against the text column. */
	.prose {
		position: relative;
	}
	.prose :global([id]) {
		scroll-margin-top: 1.5rem;
	}
	.prose :global(img) {
		margin: 2rem auto;
	}
</style>
