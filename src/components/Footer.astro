---
import { GITHUB_URL, url } from '../consts';

const year = new Date().getFullYear();
---

<footer class="container muted">
	<p>
		<span>© {year} chenhunghan</span>
		<span class="links">
			<a href={url('rss.xml')} aria-label="RSS feed">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"
					><path
						fill="currentColor"
						d="M2 1.75A.75.75 0 0 1 2.75 1C9.54 1 15 6.46 15 13.25a.75.75 0 0 1-1.5 0A10.75 10.75 0 0 0 2.75 2.5.75.75 0 0 1 2 1.75Zm0 4.5a.75.75 0 0 1 .75-.75 7.75 7.75 0 0 1 7.75 7.75.75.75 0 0 1-1.5 0A6.25 6.25 0 0 0 2.75 7 .75.75 0 0 1 2 6.25ZM2 12a2 2 0 1 1 4 0 2 2 0 0 1-4 0Z"
					></path></svg
				>
			</a>
			<a href={GITHUB_URL} aria-label="chenhunghan on GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</span>
	</p>
</footer>
<style>
	p {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin: 0;
		padding-block: 2rem 3rem;
		border-top: 1px solid var(--border);
		font-size: 0.875rem;
		line-height: 1;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.links a {
		display: flex;
		color: var(--muted);
	}
	.links a:hover {
		color: var(--fg);
	}
</style>
