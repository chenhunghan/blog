---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { url } from '../consts';
import { langOf, type Lang, versions } from '../i18n';
import BlogPost from '../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { ...post, versions: versions(post, posts).map((v) => ({ lang: langOf(v), href: url(`${v.id}/`) })) },
	}));
}
type Props = CollectionEntry<'blog'> & { versions: { lang: Lang; href: string }[] };

const post = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} id={post.id} headings={headings} versions={post.versions}>
	<Content />
</BlogPost>
